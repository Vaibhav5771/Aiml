# Copy this to .env for local development. .env is gitignored.
# This key must never reach the app bundle or git. That is the whole reason
# this proxy exists (spec 0001).

GEMINI_API_KEY=

# The second opinion (spec 0005): the full URL of the classifier service's
# /classify endpoint, and the shared secret it checks.
#
# Hugging Face's serverless inference does not serve Recycling-Net-11, so this
# points at the service in `classifier/`, deployed to a free Space you own.
# `classifier/README.md` has the ten minute deploy.
#
#   CLASSIFIER_URL=https://<you>-<space>.hf.space/classify
#
# BOTH OPTIONAL. With no URL the proxy skips the classifier and returns exactly
# the read Gemini alone produces. The app is no worse off than it is today,
# which is the behaviour spec 0005 AC-6 requires. With no token the service is
# called unauthenticated, which works only while the Space has no secret set.
CLASSIFIER_URL=
CLASSIFIER_TOKEN=
