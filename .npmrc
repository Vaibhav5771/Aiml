# This machine's global npm config has `omit=optional`, which silently skips
# every optional dependency. That breaks any package shipping a native binary
# per platform: lightningcss (which Tailwind v4 needs) installs its JavaScript
# but not its `.node` binary, and the build fails with a confusing
# "Cannot find module '../lightningcss.win32-x64-msvc.node'".
#
# `include` beats `omit` whichever order they are set in, so this restores
# optional dependencies for this project only and leaves your global config
# alone.
include=optional
