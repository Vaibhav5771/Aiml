# Copy this to .env and fill it in. .env is gitignored.
# Only EXPO_PUBLIC_ values reach the app bundle, and anyone holding the build
# can read them, so never put a secret behind that prefix.

# The deployed URL of your vision proxy, e.g. https://recyclens-proxy.vercel.app
EXPO_PUBLIC_PROXY_URL=

# Your Clerk app's publishable key (Clerk Dashboard > API Keys). Safe to
# expose: it identifies the Clerk instance, not a credential.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
